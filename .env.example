# API Gateway Base URL
VITE_API_BASE_URL=/api

# Baidu Map Web API Access Key (可选，留空使用内置演示Key)
VITE_BAIDU_MAP_AK=

# 顶栏用户信息(姓名/部门/头像 + 退出下拉)是否展示
# 默认展示；填 false / 0 / off / no 任一即隐藏(不区分大小写)
VITE_SHOW_USER_INFO=true

# 待办 mock 数据总量(默认 10000)，用于验证大数据量下的分页表现
# 填 12 即还原手写的 12 条精简演示数据
VITE_MOCK_TODO_TOTAL=10000
