{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "paths": {
      "@unified-todo/shared": ["../../packages/shared/src"],
      "@unified-todo/todo-core": ["../../packages/todo-core/src"],
      "@unified-todo/micro-app": ["../../packages/micro-app/src"]
    }
  },
  "include": ["src"],
  // doc/ 仅存放需求文档,显式排除,避免后续扩大 include 时被卷进编译/构建
  "exclude": ["doc"]
}
